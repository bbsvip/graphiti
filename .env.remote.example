# Copy to .env at the repository root for docker-compose.remote.yml.
NEO4J_URI=bolt://192.168.1.11:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
LOCAL_MODEL_URL=http://192.168.1.11:7997
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Select the running reranker and OpenAI models on /admin.
RERANKER_MODEL_NAME=
GRAPHITI_PORT=8000
GRAPHITI_BIND_HOST=127.0.0.1
# Optional local LLM; also selectable at /admin. Embeddings remain on Infinity.
LLM_PROVIDER=oauth
LLM_BASE_URL=
